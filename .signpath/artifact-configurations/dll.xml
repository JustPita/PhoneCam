<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration d'artefact SignPath « dll » : la DLL de caméra virtuelle, signée avant d'être
     embarquée dans PhoneCam.exe. L'artefact GitHub est un zip contenant PhoneCamSource.dll. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="PhoneCamSource.dll" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
