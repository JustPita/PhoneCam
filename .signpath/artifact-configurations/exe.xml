<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration d'artefact SignPath « exe » : l'application PC (DLL déjà signée embarquée).
     L'artefact GitHub est un zip contenant PhoneCam.exe.
     Le nom du produit est imposé (exigence SignPath Foundation) ; la version vient de pc/common/version.h. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="PhoneCam.exe" max-matches="1" product-name="PhoneCam">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
